{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "joranski/flux",
    "version": "0.3.0",
    "description": "Filament-free Flux UI Blade building blocks (list clip cards/rows) for Livewire apps",
    "keywords": [
        "laravel",
        "livewire",
        "flux",
        "flux-ui",
        "blade",
        "components"
    ],
    "license": "MIT",
    "type": "library",
    "repositories": [
        {
            "name": "flux-pro",
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "livewire/flux": "^2.0",
        "livewire/flux-pro": "^2.1",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Joranski\\Flux\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joranski\\Flux\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joranski\\Flux\\FluxServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --compact"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
